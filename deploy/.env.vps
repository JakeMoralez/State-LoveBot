# Production VPS — /opt/State-LoveBot
# Скопировать: cp deploy/.env.vps /opt/State-LoveBot/.env
# Путь DATABASE_URL должен совпадать с BOT_DATABASE_URL в /opt/State-Love-Admin/.env

VK_GROUP_ID=
VK_GROUP_TOKEN=
VK_USER_TOKEN=

MAIN_ADMIN_ID=
MAIN_ADMIN_USERNAME=

LOG_CHAT_ID=0

DEFAULT_SERVER_ID=30
DEFAULT_SERVER_SLUG=default

# Абсолютный путь — тот же файл, что BOT_DATABASE_URL в панели
DATABASE_URL=sqlite:////opt/State-LoveBot/bot.db

SLED_BOT_SECRET=
SLED_INTERNAL_PORT=8081

PANEL_BASE_URL=https://love.vlesnix.site
PANEL_INTERNAL_URL=http://127.0.0.1:8000
PANEL_DATABASE_URL=sqlite:////opt/State-Love-Admin/data/panel.db

LOG_LEVEL=INFO

FORUM_BASE_URL=https://forum.arizona-rp.com
FORUM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
FORUM_XF_USER=
FORUM_XF_SESSION=
FORUM_XF_TFA_TRUST=
