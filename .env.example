# VK API
VK_GROUP_ID=123456789
VK_GROUP_TOKEN=your_group_token
# Опционально: токен вашего VK-аккаунта (не группы).
# Нужен для /mute, /stitle и полного списка участников.
# Права: messages, friends, offline. Kate Mobile: client_id=2685278 в OAuth-ссылке.
VK_USER_TOKEN=

# Главный администратор (получит уровень 10 при первом запуске)
MAIN_ADMIN_ID=123456789
MAIN_ADMIN_USERNAME=your_username

# Логи действий: в личку MAIN_ADMIN_ID (приоритет), иначе LOG_CHAT_ID
LOG_CHAT_ID=0

# Сервер по умолчанию (тег, имя, раздел исков — через /setserver в боте)
DEFAULT_SERVER_ID=30
DEFAULT_SERVER_SLUG=default

# База данных Tortoise ORM
DATABASE_URL=sqlite://bot.db

# ArzLove Sled — internal API (127.0.0.1, только localhost)
SLED_BOT_SECRET=
SLED_INTERNAL_PORT=8081

# Панель след. ЦА — ссылки входа /panel (тот же секрет, что у State-LoveAdmin)
PANEL_BASE_URL=https://love.vlesnix.site
# Internal API панели (127.0.0.1, для /editmydiscord)
PANEL_INTERNAL_URL=http://127.0.0.1:8000

# Логирование
LOG_LEVEL=INFO

# Форум — cookies из браузера (F12 → Application → Cookies → forum.arizona-rp.com)
FORUM_BASE_URL=https://forum.arizona-rp.com
FORUM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
FORUM_XF_USER=
FORUM_XF_SESSION=
FORUM_XF_TFA_TRUST=
