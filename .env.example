# VK API
VK_GROUP_ID=123456789
VK_GROUP_TOKEN=your_group_token
VK_USER_TOKEN=your_user_token

# Главный администратор (получит уровень 10 при первом запуске)
MAIN_ADMIN_ID=123456789
MAIN_ADMIN_USERNAME=your_username

# Логи действий: в личку MAIN_ADMIN_ID (приоритет), иначе LOG_CHAT_ID
LOG_CHAT_ID=0

# Сервер по умолчанию
DEFAULT_SERVER_SLUG=default
DEFAULT_SERVER_NAME=Arizona RP Queen Creek
SERVER_NUMBER=21
SERVER_TAG=Love

# База данных Tortoise ORM
DATABASE_URL=sqlite://bot.db

# Логирование
LOG_LEVEL=INFO

# Форум — cookies из браузера (F12 → Application → Cookies → forum.arizona-rp.com)
FORUM_BASE_URL=https://forum.arizona-rp.com
FORUM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
FORUM_XF_USER=
FORUM_XF_SESSION=
FORUM_XF_TFA_TRUST=
